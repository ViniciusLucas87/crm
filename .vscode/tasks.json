{
  "version": "2.0.0",
  "tasks": [
    { "label": "PNS: Start local platform", "type": "shell", "command": "docker compose up -d", "problemMatcher": [] },
    { "label": "PNS: Stop local platform", "type": "shell", "command": "docker compose down", "problemMatcher": [] },
    { "label": "PNS: Show service status", "type": "shell", "command": "docker compose ps", "problemMatcher": [] },
    { "label": "PNS: Follow API logs", "type": "shell", "command": "docker compose logs --tail=200 -f api", "problemMatcher": [] },
    { "label": "PNS: Run database migrations", "type": "shell", "command": "docker compose exec api alembic upgrade head", "problemMatcher": [] },
    {
      "label": "PNS: Test backlog features",
      "type": "shell",
      "command": "pytest -q apps/api/tests/test_llm_gateway.py apps/api/tests/test_discovery_engine.py apps/api/tests/test_lead_enrichment_cost_controls.py apps/api/tests/test_conversations_email_timeline.py apps/api/tests/test_call_center.py apps/api/tests/test_telnyx_redaction.py apps/api/tests/test_dashboard.py",
      "options": { "env": { "PYTHONPATH": "${workspaceFolder}/apps/api;${workspaceFolder}/apps/worker" } },
      "problemMatcher": []
    },
    { "label": "PNS: Test web", "type": "shell", "command": "npm test --workspace apps/web", "problemMatcher": [] },
    { "label": "PNS: Build CRM", "type": "shell", "command": "npm run build --workspace apps/web", "problemMatcher": [] },
    { "label": "PNS: Build website", "type": "shell", "command": "npm run build --workspace apps/marketing", "problemMatcher": [] },
    { "label": "PNS: Production deployment status", "type": "shell", "command": "railway deployment list --limit 5", "problemMatcher": [] }
  ]
}
