# ──────────────────────────────────────────
# Pacific North Systems — Environment Variables
# ──────────────────────────────────────────
# Copy to .env.local for local development.
# Production: set these in Vercel → Settings → Environment Variables.
# ──────────────────────────────────────────

# ── CRM Integration (Future) ──
# Base URL for the CRM API. Leave empty to skip CRM forwarding in dev.
# Production example: https://pns-crm.up.railway.app
CRM_API_BASE_URL=

# ── Site URL ──
# Used for canonical URLs, sitemap, and OG metadata.
# Local: http://localhost:3001 | Production: https://pacificnorthsystems.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Never Miss checkout
# Use live Stripe Payment Link URLs in production. Never store Stripe secret keys here.
NEVER_MISS_CHECKOUT_URL=
NEVER_MISS_PLUS_CHECKOUT_URL=
