# ──────────────────────────────────────────
# Pacific North Systems — Environment Variables
# ──────────────────────────────────────────
# Copy to .env.local for local development.
# Production: set these in Vercel → Settings → Environment Variables.
# ──────────────────────────────────────────

# ── CRM Integration (Future) ──
# Base URL for the CRM API. Leave empty to skip CRM forwarding in dev.
# Production example: https://pns-crm.up.railway.app
CRM_API_BASE_URL=

# ── Site URL ──
# Used for canonical URLs, sitemap, and OG metadata.
# Local: http://localhost:3001 | Production: https://www.pacificnorthsystems.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Google Analytics 4 measurement ID. Keep this runtime value private; the
# public measurement ID is served only by /api/analytics-config.
GA_MEASUREMENT_ID=

# Never Miss checkout
# Use live Stripe subscription Payment Links configured with a 30-day free trial.
# The payment link must collect a card and redirect to /never-miss/activate?session_id={CHECKOUT_SESSION_ID}.
# Never store Stripe secret keys here.
NEVER_MISS_FREE_TRIAL_URL=
NEVER_MISS_PLUS_FREE_TRIAL_URL=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Optional Google Ads conversion-action labels. Set the label portion only,
# after creating the matching conversion actions in Google Ads. The page still
# records standard gtag journey events when these are blank.
NEXT_PUBLIC_GOOGLE_ADS_TRIAL_CHECKOUT_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_TRIAL_ACTIVATION_LABEL=
