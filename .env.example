# ═══════════════════════════════════════════════════════════
# Pacific North Systems OS — Environment Template
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# .env is gitignored — this template is safe to commit.

# ── Environment ──
PNS_ENV=development

# ── Database ──
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/pns_crm
REDIS_URL=redis://:redis_dev@redis:6379/0

# ── API ──
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# ── Clerk Authentication (required) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
CRM_DEFAULT_ORGANIZATION_SLUG=pacific-north-systems
# Comma-separated Clerk user IDs permitted to access the private CRM.
# Production startup/authentication must fail closed when this is empty.
CRM_ALLOWED_USER_IDS=

# ── LLM Providers ──
DEEPSEEK_API_KEY=
GOOGLE_PLACES_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=https://api.pacificnorthsystems.com/api/v1/reddit/oauth/callback
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── LLM Cost Governance (Sprint: Production Hardening) ──
# Kill switch: set to false to disable all LLM calls (CRMs uses deterministic fallbacks)
LLM_ENABLED=true
# Model routing: flash/cheap model for most calls, Pro only for allowlist
LLM_FLASH_MODEL=deepseek-v4-flash
LLM_PRO_MODEL=deepseek-v4-flash
LLM_REASONING_MODEL=deepseek-chat
# Features allowed to use Pro model (comma-separated)
LLM_PRO_FEATURES=proposal
# Per-request token caps
LLM_MAX_INPUT_TOKENS=8000
LLM_OUTPUT_CLASSIFICATION=300
LLM_OUTPUT_COACHING=200
LLM_OUTPUT_ENRICHMENT=600
LLM_OUTPUT_PROPOSAL=800
# Budget limits (USD) used for the production cost ceiling
LLM_GLOBAL_DAILY_COST_LIMIT=0.25
LLM_GLOBAL_MONTHLY_COST_LIMIT=5.00
LLM_ORG_DAILY_COST_LIMIT=0.25
LLM_ORG_MONTHLY_COST_LIMIT=5.00
LLM_ORG_DAILY_REQUESTS=60
LLM_ORG_DAILY_INPUT_TOKENS=300000
LLM_ORG_DAILY_OUTPUT_TOKENS=60000
# Retry: max paid retries (only 429/5xx), base delay seconds
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_SECONDS=2.0

# ── Telephony (Telnyx) ──
TELEPHONY_PROVIDER=mock
TELNYX_API_KEY=
TELNYX_APPLICATION_ID=
TELNYX_PHONE_NUMBER=
TELNYX_WEBHOOK_SECRET=
TELNYX_PUBLIC_URL=
TELNYX_CONNECTION_ID=
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_AUTO_PROVISION_ENABLED=false
INBOUND_CALL_TRANSFER_ENABLED=false
INBOUND_CALL_TRANSFER_TIMEOUT_SECONDS=25
RECONCILIATION_GRACE_PERIOD_SECONDS=10

# Stripe fulfillment. Secrets belong only in the API service environment.
STRIPE_WEBHOOK_SECRET=
STRIPE_NEVER_MISS_PAYMENT_LINK_ID=
STRIPE_NEVER_MISS_PLUS_PAYMENT_LINK_ID=
STRIPE_CUSTOMER_PORTAL_URL=
MARKETING_SITE_URL=https://www.pacificnorthsystems.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=Pacific North Systems <hello@pacificnorthsystems.com>
# Never Forget reminders fail closed until controlled consent and delivery tests pass.
NEVER_FORGET_LIVE_MESSAGES_ENABLED=false

# ── Frontend ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Worker ──
CELERY_BROKER_URL=redis://:redis_dev@redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Operational retention. Audit history is preserved; transient worker and
# delivery records are cleaned on a bounded schedule.
OPERATIONAL_CLEANUP_ENABLED=true
CLEANUP_WORKER_SUCCESS_DAYS=7
CLEANUP_WORKER_FAILURE_DAYS=90
CLEANUP_OUTBOX_COMPLETED_DAYS=30
CLEANUP_OUTBOX_FAILED_DAYS=90
CLEANUP_WEBHOOK_PROCESSED_DAYS=180
CLEANUP_AI_REQUEST_DAYS=180
CLEANUP_MCP_TOOL_DAYS=90

# ── Feature Flags ──
ENABLE_TELEPHONY=true
ENABLE_WEBRTC=false
ENABLE_RECORDING=false
ENABLE_INCOMING_CALLS=false
# Reddit commercial API access lifecycle: pending_approval, configured, or leave blank.
REDDIT_ACCESS_STATUS=
