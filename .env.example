# ═══════════════════════════════════════════════════════════
# Pacific North Systems OS — Environment Template
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# .env is gitignored — this template is safe to commit.

# ── Environment ──
PNS_ENV=development

# ── Database ──
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/pns_crm
REDIS_URL=redis://redis:6379/0

# ── API ──
API_HOST=0.0.0.0
API_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000

# ── Clerk Authentication (required) ──
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
# Comma-separated Clerk user IDs permitted to access the private CRM.
# Production startup/authentication must fail closed when this is empty.
CRM_ALLOWED_USER_IDS=

# ── LLM Providers ──
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Telephony (Telnyx) ──
TELEPHONY_PROVIDER=mock
TELNYX_API_KEY=
TELNYX_APPLICATION_ID=
TELNYX_PHONE_NUMBER=
TELNYX_WEBHOOK_SECRET=
TELNYX_PUBLIC_URL=

# ── Frontend ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Worker ──
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Feature Flags ──
ENABLE_TELEPHONY=true
ENABLE_WEBRTC=false
ENABLE_RECORDING=false
ENABLE_INCOMING_CALLS=false
